# -----------------------------------------------------------------------
# .env.example — Configuration template for the eBay Console Scanner Bot
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your values below
#   3. NEVER commit your .env file to version control!
# -----------------------------------------------------------------------


# -----------------------------------------------------------------------
# eBay Developer API Credentials  (OPTIONAL but strongly recommended)
#
# Get yours for FREE at: https://developer.ebay.com/my/keys
#   → Sign in with your eBay account
#   → Click "Create a Keyset"
#   → Choose "Production" environment
#   → Copy "App ID (Client ID)" and "Cert ID (Client Secret)"
#
# If you leave these blank the bot falls back to web scraping.
# -----------------------------------------------------------------------
EBAY_APP_ID=YourAppName-YourBot-PRD-xxxxxxxx-xxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 'production' (real listings) or 'sandbox' (test environment)
EBAY_ENVIRONMENT=production


# -----------------------------------------------------------------------
# Discord Webhook URL  (REQUIRED for notifications)
#
# How to create one:
#   1. Open your Discord server
#   2. Server Settings → Integrations → Webhooks
#   3. Click "New Webhook"
#   4. Choose a channel, give it a name, click "Copy Webhook URL"
#   5. Paste the URL below
# -----------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# -----------------------------------------------------------------------
# Scan Settings
# -----------------------------------------------------------------------

# How often to run a full scan (minutes).  Minimum recommended: 5
SCAN_INTERVAL_MINUTES=5

# Maximum number of results to request per eBay search query (1–200)
MAX_RESULTS_PER_QUERY=50

# Price filter — listings outside this range are ignored
# Set MAX_PRICE=0 to disable the price ceiling
MIN_PRICE=0
MAX_PRICE=300


# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

# Path to the SQLite database file.
# Defaults to seen_items.db in the ebay-scanner/ directory.
# DB_PATH=/absolute/path/to/seen_items.db


# -----------------------------------------------------------------------
# Request Delays (seconds) — be polite to eBay's servers
# Only relevant when using the scraping fallback (no API keys).
# -----------------------------------------------------------------------
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.5
